---
import { url } from '~/lib/url';
---

<a class="logo" href={url('/')} aria-label="Secure Urban Airspace, NASA ULI home">
  <svg class="logo__mark" viewBox="0 0 32 32" aria-hidden="true">
    <circle cx="16" cy="16" r="14.25" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
    <circle cx="16" cy="16" r="8" fill="none" stroke="currentColor" stroke-width="1" opacity="0.45"></circle>
    <path d="M16 16 L26.1 5.9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
    <path d="M16 1.75v3M16 27.25v3M1.75 16h3M27.25 16h3" stroke="currentColor" stroke-width="1.25" opacity="0.6"></path>
    <circle class="logo__blip" cx="21.5" cy="12.5" r="2.25"></circle>
  </svg>
  <span class="logo__text">
    <span class="logo__name">Secure Urban Airspace</span>
    <span class="logo__program">NASA ULI · 2024–2027</span>
  </span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    text-decoration: none;
    color: var(--ink);
  }
  .logo__mark {
    width: clamp(34px, 30px + 0.8vw, 42px);
    height: clamp(34px, 30px + 0.8vw, 42px);
    flex: none;
  }
  .logo__blip {
    fill: var(--accent-graphic);
  }
  .logo:hover .logo__mark path:first-of-type {
    transform-origin: 16px 16px;
    animation: sweep 1.6s var(--ease) both;
  }
  @keyframes sweep {
    to {
      transform: rotate(360deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .logo:hover .logo__mark path:first-of-type {
      animation: none;
    }
  }
  .logo__text {
    display: grid;
    gap: 0.2rem;
    line-height: 1.05;
  }
  .logo__name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.05rem, 0.95rem + 0.45vw, 1.3rem);
    letter-spacing: -0.015em;
  }
  .logo__program {
    font-family: var(--font-mono);
    font-size: clamp(0.68rem, 0.64rem + 0.18vw, 0.78rem);
    letter-spacing: var(--track-label);
    color: var(--ink-3);
    text-transform: uppercase;
  }
</style>
