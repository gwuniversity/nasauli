---
import type { CollectionEntry } from 'astro:content';
import { url } from '~/lib/url';

interface Props {
  tools: CollectionEntry<'tools'>[];
  teamNames: Record<string, string>;
  /** One item per row, for narrow sidebars. */
  stacked?: boolean;
}

const { tools, teamNames, stacked = false } = Astro.props;
const kindLabel = { simulator: 'Simulator', dataset: 'Dataset', software: 'Software' };
---

{
  tools.length > 0 && (
    <div class:list={['toollist', { 'toollist--stacked': stacked }]}>
      <p class="eyebrow">Tools &amp; datasets</p>
      <ul role="list">
        {tools.map((t) => (
          <li>
            <span class="toollist__kind mono">{kindLabel[t.data.kind]}</span>
            <span class="toollist__name">
              {t.data.url ? (
                <a href={t.data.url} rel="noopener">
                  {t.data.name} ↗
                </a>
              ) : (
                <a href={url('/demos#tools-title')}>{t.data.name}</a>
              )}
            </span>
            <span class="toollist__teams mono">{t.data.teams.map((x) => teamNames[x.id]).join(' · ')}</span>
          </li>
        ))}
      </ul>
    </div>
  )
}

<style>
  .toollist ul {
    margin-top: var(--space-4);
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--ink);
  }
  .toollist li {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr) auto;
    align-items: baseline;
    gap: var(--space-4);
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--line);
  }
  .toollist__kind,
  .toollist__teams {
    font-size: var(--text-label);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .toollist__kind {
    color: var(--accent);
  }
  .toollist__name a {
    font-weight: 550;
    text-decoration: none;
  }
  .toollist__name a:hover {
    color: var(--accent);
  }
  .toollist--stacked li {
    grid-template-columns: 1fr;
    gap: var(--space-1);
  }
  @media (max-width: 600px) {
    .toollist li {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }
  }
</style>
