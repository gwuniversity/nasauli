---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';

interface Props {
  figure: CollectionEntry<'figures'>;
  /** team id → short name, for the credit line */
  teamNames: Record<string, string>;
  sizes?: string;
}

const { figure, teamNames, sizes = '(min-width: 1000px) 560px, 100vw' } = Astro.props;
const { src, alt, caption, teams, dark } = figure.data;
---

<figure class:list={['figure', { 'figure--dark': dark }]}>
  <a
    class="figure__frame"
    href={src.src}
    target="_blank"
    rel="noopener"
    aria-label={`View larger: ${alt}`}
    data-lightbox
    data-caption={caption}
    data-alt={alt}
    data-dark={dark ? 'true' : undefined}
  >
    <Image src={src} alt={alt} widths={[480, 800, 1200, 1600].filter((w) => w <= src.width * 1.2)} sizes={sizes} />
  </a>
  <figcaption>
    <span class="figure__credit mono">{teams.map((t) => teamNames[t.id] ?? t.id).join(' · ')}</span>
    {caption}
  </figcaption>
</figure>

<script>
  // One shared viewer for every figure on the page. Without JS, the link opens the image instead.
  let dialog: HTMLDialogElement | null = null;
  const ensureDialog = () => {
    if (dialog) return dialog;
    dialog = document.createElement('dialog');
    dialog.className = 'lightbox';
    dialog.innerHTML = `
      <figure class="lightbox__figure">
        <img class="lightbox__img" alt="" />
        <figcaption class="lightbox__caption"></figcaption>
      </figure>
      <button class="lightbox__close" type="button" aria-label="Close">×</button>`;
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog || (e.target as HTMLElement).closest('.lightbox__close')) dialog!.close();
    });
    document.body.append(dialog);
    return dialog;
  };
  document.querySelectorAll<HTMLAnchorElement>('[data-lightbox]').forEach((link) => {
    link.addEventListener('click', (e) => {
      if (e.metaKey || e.ctrlKey || e.shiftKey) return;
      e.preventDefault();
      const d = ensureDialog();
      const img = d.querySelector<HTMLImageElement>('.lightbox__img')!;
      img.src = link.href;
      img.alt = link.dataset.alt ?? '';
      img.classList.toggle('is-dark', link.dataset.dark === 'true');
      d.querySelector('.lightbox__caption')!.textContent = link.dataset.caption ?? '';
      d.showModal();
    });
  });
</script>

<style is:global>
  .lightbox {
    width: min(96vw, 1400px);
    max-width: none;
    max-height: 94vh;
    padding: var(--space-5);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-3);
    background: var(--bg-raised);
    color: var(--ink);
    box-shadow: var(--shadow-2);
  }
  .lightbox::backdrop {
    background: rgb(6 10 18 / 0.72);
    backdrop-filter: blur(3px);
  }
  .lightbox__figure {
    display: grid;
    gap: var(--space-4);
  }
  .lightbox__img {
    width: 100%;
    max-height: calc(94vh - 9rem);
    object-fit: contain;
    border-radius: var(--radius-2);
    background: #fff;
  }
  .lightbox__img.is-dark {
    background: #000;
  }
  .lightbox__caption {
    font-size: var(--text-sm);
    color: var(--ink-2);
    max-width: 90ch;
  }
  .lightbox__close {
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
    width: 40px;
    height: 40px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: var(--bg-raised);
    font-size: 1.4rem;
    line-height: 1;
  }
  .lightbox__close:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
</style>

<style>
  .figure {
    display: grid;
    gap: var(--space-3);
    align-content: start;
  }
  .figure__frame {
    display: grid;
    place-items: center;
    overflow: hidden;
    padding: var(--space-3);
    border: 1px solid var(--line);
    border-radius: var(--radius-2);
    background: #fff;
    transition: border-color 0.2s var(--ease);
  }
  .figure--dark .figure__frame {
    background: #000;
    padding: 0;
  }
  :global([data-theme='dark']) .figure:not(.figure--dark) .figure__frame {
    background: #e4e8ee;
    border-color: var(--line-strong);
  }
  :global([data-theme='dark']) .figure__frame img {
    filter: brightness(0.92) contrast(1.02);
  }
  .figure__frame {
    cursor: zoom-in;
  }
  .figure__frame:hover {
    border-color: var(--accent);
  }
  .figure__frame img {
    width: 100%;
    height: auto;
  }
  figcaption {
    font-size: var(--text-xs);
    line-height: 1.5;
    color: var(--ink-2);
  }
  .figure__credit {
    display: inline-block;
    margin-right: var(--space-2);
    font-size: var(--text-label);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--accent);
  }
</style>
