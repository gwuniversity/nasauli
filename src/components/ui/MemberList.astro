---
import type { CollectionEntry } from 'astro:content';
import { roleLabels } from '~/lib/site';

interface Props {
  people: CollectionEntry<'people'>[];
}

const { people } = Astro.props;
---

<ul class="members" role="list">
  {
    people.map((p) => (
      <li>
        <span class="members__name">{p.data.name}</span>
        <span class="members__role">
          {p.data.title ?? roleLabels[p.data.role]}
          {p.data.cohort && ` · ${p.data.cohort}`}
        </span>
      </li>
    ))
  }
</ul>

<style>
  .members {
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }
  .members li {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0 var(--space-4);
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--line);
    font-size: var(--text-sm);
  }
  .members__name {
    font-weight: 550;
  }
  .members__role {
    color: var(--ink-3);
  }
</style>
