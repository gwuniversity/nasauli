---
/**
 * Click-to-play YouTube embed. Shows a thumbnail until clicked, then plays inline on our page
 * via youtube-nocookie.com, so visitors are never sent to YouTube.
 */
interface Props {
  youtubeId: string;
  title: string;
}

const { youtubeId, title } = Astro.props;
---

<lite-youtube
  videoid={youtubeId}
  playlabel={`Play: ${title}`}
  params="rel=0&modestbranding=1"
  style={`background-image: url('https://i.ytimg.com/vi/${youtubeId}/hqdefault.jpg');`}
>
  <a href={`https://www.youtube.com/watch?v=${youtubeId}`} class="lyt-playbtn" title={`Play: ${title}`}>
    <span class="lyt-visually-hidden">Play: {title}</span>
  </a>
</lite-youtube>

<script>
  import 'lite-youtube-embed';
  import 'lite-youtube-embed/src/lite-yt-embed.css';
</script>

<style is:global>
  lite-youtube {
    border-radius: var(--radius-2);
    border: 1px solid var(--line);
    max-width: none;
  }
</style>
