---
import type { CollectionEntry } from 'astro:content';
import VideoEmbed from './VideoEmbed.astro';
import { url } from '~/lib/url';

interface Props {
  demo: CollectionEntry<'demos'>;
  teamNames: Record<string, string>;
  codes: Record<string, string>;
}

const { demo, teamNames, codes } = Astro.props;
const { title, summary, youtubeId, teams, useCase } = demo.data;
---

<article class="demo" data-demo data-teams={teams.map((t) => t.id).join(' ')} data-uc={useCase?.id ?? ''}>
  <VideoEmbed youtubeId={youtubeId} title={title} />
  <div class="demo__body">
    <p class="demo__meta mono">
      {teams.map((t) => teamNames[t.id]).join(' · ')}
      {useCase && <a href={url(`/research/${useCase.id}`)}>{codes[useCase.id]}</a>}
    </p>
    <h3>{title}</h3>
    <p>{summary}</p>
  </div>
</article>

<style>
  .demo {
    display: grid;
    gap: var(--space-4);
    align-content: start;
  }
  .demo__body {
    display: grid;
    gap: var(--space-2);
  }
  .demo__meta {
    display: flex;
    gap: var(--space-3);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .demo__meta a {
    color: var(--accent);
    text-decoration: none;
  }
  .demo h3 {
    font-size: var(--step-1);
    letter-spacing: -0.015em;
  }
  .demo p:last-child {
    color: var(--ink-2);
    font-size: 0.95rem;
  }
</style>
