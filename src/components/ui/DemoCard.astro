---
import type { CollectionEntry } from 'astro:content';
import VideoEmbed from './VideoEmbed.astro';
import VideoPlayer from './VideoPlayer.astro';
import { url } from '~/lib/url';

interface Props {
  demo: CollectionEntry<'demos'>;
  teamNames: Record<string, string>;
  codes: Record<string, string>;
  /** Give the card an id anchor (#demo-<id>); off for repeated copies such as the spotlight. */
  anchor?: boolean;
}

const { demo, teamNames, codes, anchor = true } = Astro.props;
const { title, summary, youtubeId, video, mode, kind, teams, useCase } = demo.data;
const kindLabel = { simulation: 'Simulation', 'real-world': 'Real world', dashboard: 'Software' };
---

<article class="demo" id={anchor ? `demo-${demo.id}` : undefined} data-demo data-teams={teams.map((t) => t.id).join(' ')} data-uc={useCase?.id ?? ''}>
  {video ? <VideoPlayer id={video} title={title} mode={mode} /> : <VideoEmbed youtubeId={youtubeId!} title={title} />}
  <div class="demo__body">
    <p class="demo__meta mono">
      {teams.map((t) => teamNames[t.id]).join(' · ')}
      {useCase && <a href={url(`/research/${useCase.id}`)}>{codes[useCase.id]}</a>}
      {kind && <span class="demo__kind">{kindLabel[kind]}</span>}
    </p>
    <h3>{title}</h3>
    <p>{summary}</p>
  </div>
</article>

<style>
  .demo {
    display: grid;
    gap: var(--space-4);
    align-content: start;
  }
  .demo__body {
    display: grid;
    gap: var(--space-2);
  }
  .demo__meta {
    display: flex;
    gap: var(--space-3);
    font-size: var(--text-label);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .demo__meta a {
    color: var(--accent);
    text-decoration: none;
  }
  .demo h3 {
    font-size: var(--step-1);
    letter-spacing: -0.015em;
  }
  .demo__meta {
    flex-wrap: wrap;
  }
  .demo__kind {
    margin-left: auto;
  }
  .demo__shown {
    font-size: var(--text-label);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .demo__body > p:not(.demo__meta):not(.demo__shown) {
    color: var(--ink-2);
    font-size: var(--text-sm);
  }
</style>
