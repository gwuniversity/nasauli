---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Pending from './Pending.astro';
import { roleLabels } from '~/lib/site';
import { url } from '~/lib/url';

interface Props {
  person: CollectionEntry<'people'>;
  team: CollectionEntry<'teams'>;
  /** Show the institution line (off on team pages, where it is implied). */
  showTeam?: boolean;
}

const { person, team, showTeam = true } = Astro.props;
const { name, role, title, photo, website, alumni } = person.data;
const initials = name
  .split(/\s+/)
  .filter((w) => /^[A-Z]/.test(w))
  .map((w) => w[0])
  .slice(0, 2)
  .join('');
const roleLine = [roleLabels[role], title].filter(Boolean).join(' · ');
---

<article class="person">
  <div class="person__photo">
    {
      photo ? (
        <Image src={photo} alt={`Portrait of ${name}`} widths={[240, 480]} sizes="240px" />
      ) : (
        <div class="person__initials mono" aria-hidden="true">
          {initials}
        </div>
      )
    }
  </div>
  <div class="person__body">
    <h3 class="person__name">{name}</h3>
    <p class="person__role">{roleLine}{alumni && <span class="tag">Former</span>}</p>
    {showTeam && <p class="person__team mono"><a href={url(`/teams/${team.id}`)}>{team.data.short}</a></p>}
    {website && <a class="link-arrow person__link" href={website} rel="noopener">Profile</a>}
    {!photo && <Pending owner={team.data.short} what={`Headshot for ${name}`} hidePublic />}
  </div>
</article>

<style>
  .person {
    display: grid;
    gap: var(--space-4);
    align-content: start;
  }
  .person__photo {
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: var(--radius-2);
    border: 1px solid var(--line);
    background: var(--bg-sunken);
  }
  .person__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.15);
  }
  .person__initials {
    display: grid;
    place-items: center;
    height: 100%;
    font-size: clamp(1.5rem, 1rem + 2vw, 2.25rem);
    font-weight: 500;
    color: var(--ink-3);
    background:
      radial-gradient(circle at 50% 50%, transparent 0 34%, var(--line) 34.5% 35%, transparent 35.5%),
      linear-gradient(var(--map-grid) 1px, transparent 1px) 0 0 / 16px 16px,
      linear-gradient(90deg, var(--map-grid) 1px, transparent 1px) 0 0 / 16px 16px;
  }
  .person__body {
    display: grid;
    gap: var(--space-1);
  }
  .person__name {
    font-size: var(--step-1);
    letter-spacing: -0.015em;
  }
  .person__role {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--ink-2);
    line-height: 1.4;
  }
  .person__team {
    font-size: var(--text-label-lg);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .person__team a {
    color: var(--accent);
    text-decoration: none;
  }
  .person__link {
    margin-top: var(--space-1);
    font-size: var(--text-sm);
  }
</style>
