---
import { challenges } from '~/lib/site';
import { url } from '~/lib/url';
---

<section class="section section--sunken" aria-labelledby="challenges-title">
  <div class="container">
    <header class="section-head section-head--split">
      <div>
        <p class="eyebrow">Research framework</p>
        <h2 id="challenges-title" class="h2" style="margin-top: var(--space-4)">
          Three technical challenges, one integrated approach
        </h2>
      </div>
      <p class="lede">
        Each challenge feeds the next: attacks we identify become the threats we defend against, and the defenses that
        work shape the architecture we harden.
      </p>
    </header>

    <ol class="route" role="list">
      {
        challenges.map((tc, i) => (
          <li class="leg" data-reveal style={`transition-delay: ${i * 90}ms`}>
            <div class="leg__waypoint" aria-hidden="true">
              <span />
            </div>
            <p class="leg__code mono">{tc.id}</p>
            <h3 class="leg__title">{tc.title}</h3>
            <p class="leg__heading">{tc.heading}</p>
            <p class="leg__body">{tc.body}</p>
            <ul class="leg__tasks" role="list">
              {tc.tasks.map((task, j) => (
                <li>
                  <span class="mono">
                    {i + 1}.{j + 1}
                  </span>
                  {task}
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>

    <div class="validation" data-reveal>
      <span class="tag tag--accent">Cross-cutting</span>
      <p>
        <strong>Validation and demonstration:</strong> simulation testing, hardware testbeds, and integrated
        live-virtual-constructive demonstrations, with Year 3 focused on aviation use-case demos.
      </p>
      <a class="link-arrow" href={url('/research')}>Research overview</a>
    </div>
  </div>
</section>

<style>
  .route {
    position: relative;
    display: grid;
    gap: var(--space-7);
    padding: 0;
    list-style: none;
  }
  @media (min-width: 900px) {
    .route {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-6);
    }
    .route::before {
      content: '';
      position: absolute;
      top: 7px;
      left: 0;
      right: 0;
      border-top: 1.5px dashed var(--line-strong);
    }
  }
  .leg {
    position: relative;
    display: grid;
    gap: var(--space-3);
    align-content: start;
  }
  .leg__waypoint {
    position: relative;
    width: 16px;
    height: 16px;
    margin-bottom: var(--space-3);
    border: 1.5px solid var(--ink);
    border-radius: 50%;
    background: var(--bg-sunken);
    display: grid;
    place-items: center;
  }
  .leg__waypoint span {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent-graphic);
  }
  .leg__code {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: var(--accent);
  }
  .leg__title {
    font-size: var(--step-4);
    letter-spacing: -0.035em;
  }
  .leg__heading {
    font-size: var(--step-1);
    font-weight: 550;
    line-height: 1.3;
  }
  .leg__body {
    color: var(--ink-2);
  }
  .leg__tasks {
    display: grid;
    gap: var(--space-2);
    margin-top: var(--space-3);
    padding: var(--space-4) 0 0;
    border-top: 1px solid var(--line);
    list-style: none;
    font-size: 0.9rem;
    color: var(--ink-2);
  }
  .leg__tasks li {
    display: grid;
    grid-template-columns: 2.25rem 1fr;
  }
  .leg__tasks .mono {
    font-size: 0.75rem;
    padding-top: 0.15rem;
    color: var(--ink-3);
  }

  .validation {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-5);
    margin-top: var(--space-8);
    padding: var(--space-5) var(--space-6);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-3);
    background: var(--bg-raised);
  }
  .validation p {
    flex: 1 1 380px;
    color: var(--ink-2);
  }
  .validation strong {
    color: var(--ink);
    font-weight: 600;
  }
</style>
