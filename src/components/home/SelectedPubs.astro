---
import { getCollection } from 'astro:content';
import { getTeams, publicationHref } from '~/lib/content';
import { url } from '~/lib/url';

const all = await getCollection('publications');
const featured = all.filter((p) => p.data.featured).sort((a, b) => b.data.year - a.data.year);
const teamNames = Object.fromEntries((await getTeams()).map((t) => [t.id, t.data.short]));
const shortAuthors = (a: string[]) => (a.length > 3 ? `${a[0]} et al.` : a.join(', '));
---

{
  featured.length > 0 && (
    <section class="section" aria-labelledby="selected-pubs-title">
      <div class="container">
        <header class="section-head section-head--split">
          <div>
            <p class="eyebrow">Publications</p>
            <h2 id="selected-pubs-title" class="h2 mt-4">
              Selected publications
            </h2>
          </div>
          <p class="sp__all">
            <a class="link-arrow" href={url('/publications')}>
              All {all.length} publications
            </a>
          </p>
        </header>
        <ul class="sp" role="list">
          {featured.map((p) => (
            <li data-reveal>
              <a class="sp__card" href={publicationHref(p)} rel="noopener">
                <p class="sp__venue mono">
                  {p.data.venue.replace(/ \(.*\)$/, '')} · {p.data.year}
                </p>
                <h3>{p.data.title}</h3>
                <p class="sp__authors">{shortAuthors(p.data.authors)}</p>
                <p class="sp__teams mono">{p.data.teams.map((t) => teamNames[t.id]).join(' · ')}</p>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

<style>
  .sp__all {
    justify-self: end;
  }
  .sp {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-4);
    padding: 0;
    list-style: none;
  }
  .sp__card {
    display: grid;
    grid-template-rows: auto 1fr auto auto;
    gap: var(--space-3);
    height: 100%;
    padding: var(--space-5);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-2);
    background: var(--bg-raised);
    text-decoration: none;
    transition:
      transform 0.25s var(--ease),
      box-shadow 0.25s var(--ease),
      border-color 0.25s var(--ease);
  }
  .sp__card:hover {
    transform: translateY(-3px);
    border-color: var(--accent);
    box-shadow: var(--shadow-2);
  }
  .sp__venue {
    font-size: var(--text-label);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--accent);
  }
  .sp__card h3 {
    font-size: var(--text-md);
    line-height: 1.35;
    letter-spacing: -0.01em;
  }
  .sp__authors {
    font-size: var(--text-xs);
    color: var(--ink-2);
  }
  .sp__teams {
    padding-top: var(--space-3);
    border-top: 1px solid var(--line);
    font-size: var(--text-label);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--ink-3);
  }
</style>
