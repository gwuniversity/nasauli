---
import { url } from '~/lib/url';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__stage" aria-hidden="true">
    <canvas class="hero__canvas" data-airspace></canvas>
    <div class="hero__veil"></div>
  </div>

  <div class="container hero__inner">
    <div class="hero__copy">
      <p class="eyebrow">NASA University Leadership Initiative</p>
      <h1 id="hero-title" class="display">Securing the skies over our&nbsp;cities.</h1>
      <p class="lede">
        Drones and air taxis will soon share dense urban airspace, relying on software, sensors, and wireless links
        that can be attacked. Eight institutions are working together to find those weaknesses, defend against them,
        and design them out.
      </p>
      <div class="hero__actions">
        <a class="btn" href={url('/research')}>
          Explore the research
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h9M8.5 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6"></path></svg>
        </a>
        <a class="btn btn--ghost" href={url('/teams')}>Meet the teams</a>
      </div>
    </div>

    <dl class="hero__readout mono" aria-hidden="true" data-readout data-phase="nominal">
      <div><dt>Sector</dt><dd>URBAN-01</dd></div>
      <div><dt>Tracks</dt><dd data-readout-tracks>—</dd></div>
      <div>
        <dt>Remote ID</dt>
        <dd><span class="hero__dot"></span><span data-readout-rid>Nominal</span></dd>
      </div>
      <div class="hero__readout-status"><dt>Status</dt><dd data-readout-status>All broadcasts consistent</dd></div>
    </dl>
  </div>

  <p class="visually-hidden">
    Animated illustration: drone traffic over a city. One aircraft broadcasts a false position; the system detects the
    mismatch, marks an unsafe region around its true location, and nearby traffic routes around it.
  </p>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    min-height: min(calc(100svh - var(--header-h)), 860px);
    display: grid;
    align-items: center;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
  }
  .hero__stage {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .hero__canvas {
    width: 100%;
    height: 100%;
  }
  .hero__veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, var(--bg) 0%, color-mix(in srgb, var(--bg) 88%, transparent) 30%, transparent 62%),
      linear-gradient(0deg, var(--bg) 0%, transparent 22%);
  }
  @media (max-width: 800px) {
    .hero__veil {
      background:
        linear-gradient(180deg, color-mix(in srgb, var(--bg) 35%, transparent) 0%, color-mix(in srgb, var(--bg) 92%, transparent) 45%, var(--bg) 100%);
    }
  }

  .hero__inner {
    display: grid;
    gap: var(--space-7);
    padding-block: var(--space-9);
  }
  .hero__copy {
    display: grid;
    gap: var(--space-5);
    max-width: 640px;
  }
  .hero__copy .display {
    max-width: 12ch;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  .hero__readout {
    justify-self: end;
    align-self: end;
    display: grid;
    grid-template-columns: repeat(3, auto);
    gap: var(--space-2) var(--space-5);
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-2);
    background: color-mix(in srgb, var(--bg-raised) 78%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    box-shadow: var(--shadow-1);
  }
  .hero__readout dt {
    color: var(--ink-3);
  }
  .hero__readout dd {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--ink);
    font-weight: 500;
  }
  .hero__readout-status {
    grid-column: 1 / -1;
    padding-top: var(--space-2);
    border-top: 1px solid var(--line);
  }
  .hero__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent-graphic);
    box-shadow: 0 0 0 3px var(--accent-soft);
    transition: background-color 0.3s var(--ease);
  }
  [data-phase='spoofing'] .hero__dot {
    background: var(--signal-graphic);
    box-shadow: 0 0 0 3px var(--signal-soft);
  }
  [data-phase='spoofing'] [data-readout-rid],
  [data-phase='spoofing'] [data-readout-status] {
    color: var(--signal);
  }
  [data-phase='detected'] [data-readout-status] {
    color: var(--accent);
  }

  @media (max-width: 800px) {
    .hero {
      align-items: end;
    }
    .hero__inner {
      padding-top: 38svh;
      padding-bottom: var(--space-7);
    }
    .hero__readout {
      display: none;
    }
  }
</style>

<script>
  import { startAirspace, type AirspaceStatus } from '~/scripts/airspace';

  const canvas = document.querySelector<HTMLCanvasElement>('[data-airspace]');
  const readout = document.querySelector<HTMLElement>('[data-readout]');
  const tracks = readout?.querySelector('[data-readout-tracks]');
  const rid = readout?.querySelector('[data-readout-rid]');
  const status = readout?.querySelector('[data-readout-status]');

  const copy: Record<AirspaceStatus['phase'], [string, string]> = {
    nominal: ['Nominal', 'All broadcasts consistent'],
    spoofing: ['Anomaly', 'Broadcast diverges from RF measurements'],
    detected: ['Anomaly', 'Spoofer localized · traffic rerouted'],
    recovering: ['Nominal', 'Unsafe region cleared'],
  };

  if (canvas) {
    startAirspace(canvas, ({ phase, tracks: count }) => {
      if (!readout) return;
      readout.dataset.phase = phase;
      if (tracks) tracks.textContent = String(count);
      if (rid) rid.textContent = copy[phase][0];
      if (status) status.textContent = copy[phase][1];
    });
  }
</script>
